# Database
DATABASE_URL=postgresql://csvat:csvat_pass@localhost:5432/csvat_db

# Redis
REDIS_URL=redis://localhost:6379/0

# CoRE Stack API
CORESTACK_API_BASE_URL=https://api.core-stack.org
CORESTACK_API_KEY=your-api-key-here

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# GEE (Google Earth Engine REST API)
GEE_API_KEY=your-gee-api-key-here
GEE_PROJECT=earthengine-public
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_KEY_FILE=path/to/gee-key.json
